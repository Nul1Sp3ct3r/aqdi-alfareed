# ─────────────────────────────────────────────────────────────
#  Aqdi Alfareed — Environment Variables
#  Copy this file to .env.local for local development.
#  Set the same keys in Vercel → Project Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Site URL (no trailing slash)
# Vercel sets VERCEL_URL automatically; override with your custom domain.
NEXT_PUBLIC_SITE_URL=https://aqdi-alfareed.vercel.app

# ── Social & Contact ──────────────────────────────────────────

# WhatsApp Business link (replace 966XXXXXXXXX with your number)
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/966000000000

# Instagram profile URL
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/aqdi.alfareed

# Contact email address
NEXT_PUBLIC_CONTACT_EMAIL=info@aqdi-alfareed.com

# ── Firebase (uncomment when connecting) ──────────────────────
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Supabase (alternative to Firebase) ───────────────────────
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Payment Gateway ───────────────────────────────────────────
# Moyasar (Saudi payment gateway)
# MOYASAR_SECRET_KEY=          ← server-only, NO NEXT_PUBLIC_ prefix
# NEXT_PUBLIC_MOYASAR_PK=

# Stripe (international)
# STRIPE_SECRET_KEY=           ← server-only
# NEXT_PUBLIC_STRIPE_PK=

# ── Admin Auth (server-only) ──────────────────────────────────
# ADMIN_EMAIL=
# ADMIN_PASSWORD_HASH=
